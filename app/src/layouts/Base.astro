---
import "../styles/main.css";
import regularFont from "../assets/fonts/lxgw-wenkai/lxgw-wenkai-site.woff2?url";
import monoFont from "../assets/fonts/ibm-plex-mono/ibm-plex-mono-site.woff2?url";
import config, { absoluteUrl } from "../../site.config.mjs";

const {
    title = config.name,
    description = config.description,
    path = "/",
    schema,
    image = config.ogImage,
    imageWidth,
    imageHeight,
    imageType,
    type = "website",
    publishedTime,
    tags = [],
    keywords = [],
    hasCode = false,
    noindex = false,
} = Astro.props;

// 正文子集每个页面都要用；等宽子集只服务代码块，不让没有代码的页面白下
const fontPreloads = hasCode ? [regularFont, monoFont] : [regularFont];

const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(image);
const isDefaultImage = image === config.ogImage;
// 默认分享图 og.png 是已知的 1200×630；文章封面由 posts.js 从文件头读出真实尺寸，
// 读不到就不输出，让爬虫自己抓——写错的尺寸比不写更糟。
const ogWidth = imageWidth ?? (isDefaultImage ? 1200 : undefined);
const ogHeight = imageHeight ?? (isDefaultImage ? 630 : undefined);
const ogType = imageType ?? (isDefaultImage ? "image/png" : undefined);
const pageTitle = title === config.name ? title : `${title} · ${config.name}`;
const metaKeywords = [...new Set([...keywords, ...config.keywords])];
---

<!doctype html>
<html lang={config.locale}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content={config.themeColor} />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        {metaKeywords.length > 0 && <meta name="keywords" content={metaKeywords.join(", ")} />}
        <meta name="author" content={config.author} />
        <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
        {!noindex && <link rel="canonical" href={canonical} />}

        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/png" sizes="32x32" href={config.favicon} />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href={config.appleTouchIcon} />
        <link rel="manifest" href="/manifest.json" />
        <link rel="alternate" type="application/rss+xml" title={config.name} href="/rss.xml" />

        {/* 提前下载本页真正会用到的字体分片，减少字体替换造成的闪动 */}
        {fontPreloads.map((href) => (
            <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
        ))}

        <meta property="og:type" content={type} />
        <meta property="og:site_name" content={config.name} />
        <meta property="og:locale" content={config.locale.replace("-", "_")} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {!noindex && <meta property="og:url" content={canonical} />}
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content={title} />
        {ogType && <meta property="og:image:type" content={ogType} />}
        {ogWidth && <meta property="og:image:width" content={ogWidth} />}
        {ogHeight && <meta property="og:image:height" content={ogHeight} />}
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {tags.map((tag) => (
            <meta property="article:tag" content={tag} />
        ))}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        {/* 转义 < 防止标题或正文里出现 </script> 时提前闭合 JSON-LD（既是 XSS 也是解析失败） */}
        {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />}
    </head>
    <body>
        <main class="page">
            <slot />
        </main>
    </body>
</html>
