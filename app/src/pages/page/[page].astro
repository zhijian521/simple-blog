---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import Pagination from "../../components/Pagination.astro";
import { getPosts } from "../../lib/posts.js";
import config from "../../../site.config.mjs";

export function getStaticPaths() {
    const perPage = config.postsPerArchivePage;
    const allPosts = getPosts();

    // 首页已经能展示全部文章时，不生成归档页，避免出现没人链接、内容重复的孤岛页面
    if (allPosts.length <= config.postsOnHome) {
        return [];
    }

    const pages = Math.ceil(allPosts.length / perPage);

    return Array.from({ length: pages }, (_, index) => {
        const page = index + 1;
        return {
            params: { page: String(page) },
            props: {
                page,
                pages,
                posts: allPosts.slice((page - 1) * perPage, page * perPage),
            },
        };
    });
}

const { page, pages, posts } = Astro.props;
const title = pages > 1 ? `归档 · 第 ${page} 页` : "归档";
const description = pages > 1 ? `第 ${page} 页，共 ${pages} 页。${config.blogDescription}` : config.blogDescription;
---

<Base title={title} description={description} path={`/page/${page}/`}>
    <section class="archive">
        <header class="archive__header">
            <h1 class="archive__title">归档</h1>
            {pages > 1 && (
                <p class="archive__meta">
                    第 {page} 页，共 {pages} 页
                </p>
            )}
        </header>
        <PostList posts={posts} heading="h2" />
        {pages > 1 && <Pagination page={page} pages={pages} />}
    </section>
</Base>
