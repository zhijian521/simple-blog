---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { getNotes } from '../../lib/notes.js';

export function getStaticPaths() {
    const perPage = 10;
    const notes = getNotes();
    const pages = Math.max(1, Math.ceil(notes.length / perPage));
    return Array.from({ length: pages }, (_, index) => {
        const page = index + 1;
        return {
            params: { page: String(page) },
            props: {
                page,
                pages,
                posts: notes.slice((page - 1) * perPage, page * perPage),
            },
        };
    });
}

const { page, pages, posts } = Astro.props;
---
<Base title={`归档 · 第 ${page} 页`} path={`/page/${page}/`}>
    <section class="archive">
        <header class="archive__header">
            <h1 class="archive__title">归档</h1>
            {pages > 1 && <p class="archive__meta">第 {page} 页，共 {pages} 页</p>}
        </header>
        <PostList posts={posts} showMeta />
        {pages > 1 && <Pagination page={page} pages={pages} />}
    </section>
</Base>
