---
import Base from "../../layouts/Base.astro";
import { formatDate, getPosts } from "../../lib/posts.js";
import config, { absoluteUrl } from "../../../site.config.mjs";

export function getStaticPaths() {
    return getPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const canonical = absoluteUrl(post.url);
const siteUrl = `${config.url}/`;
const description = post.description || `${post.title}，${config.name}的技术笔记。`;
const cover = post.cover || config.ogImage;

// 正文词数按字符计（中文场景），阅读时长按每分钟 450 字估算
const plainText = post.html.replace(/<[^>]+>/g, "").replace(/\s+/g, "");
const wordCount = plainText.length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 450));

// 页面里有代码块或行内代码时，才需要额外预加载等宽子集
const hasCode = post.html.includes("<code");

const schema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": `${siteUrl}#website`,
            url: siteUrl,
            name: config.name,
            description: config.description,
            inLanguage: config.locale,
        },
        {
            "@type": "Person",
            "@id": `${siteUrl}#author`,
            name: config.author,
            url: siteUrl,
        },
        {
            "@type": "Organization",
            "@id": `${siteUrl}#publisher`,
            name: config.name,
            url: siteUrl,
            // 180×180 是实测的 apple-touch-icon 真实尺寸，补上宽高富结果测试才不告警
            logo: { "@type": "ImageObject", url: absoluteUrl(config.appleTouchIcon), width: 180, height: 180 },
        },
        {
            "@type": "BreadcrumbList",
            "@id": `${canonical}#breadcrumb`,
            itemListElement: [
                { "@type": "ListItem", position: 1, name: config.name, item: siteUrl },
                { "@type": "ListItem", position: 2, name: post.title, item: canonical },
            ],
        },
        {
            "@type": "BlogPosting",
            "@id": `${canonical}#article`,
            headline: post.title,
            description,
            image: absoluteUrl(cover),
            datePublished: post.date,
            // 没有单独的修订日期时退回发布日期，保证 dateModified 始终存在
            dateModified: post.updated || post.date,
            author: { "@id": `${siteUrl}#author` },
            publisher: { "@id": `${siteUrl}#publisher` },
            mainEntityOfPage: {
                "@type": "WebPage",
                "@id": canonical,
                isPartOf: { "@id": `${siteUrl}#website` },
            },
            inLanguage: config.locale,
            timeRequired: `PT${readingMinutes}M`,
            wordCount,
            ...(post.tags.length > 0 && { keywords: post.tags.join(", ") }),
            ...(post.category && { articleSection: post.category }),
        },
    ],
};
---

<Base
    title={post.title}
    description={description}
    path={post.url}
    image={cover}
    imageWidth={post.coverWidth}
    imageHeight={post.coverHeight}
    imageType={post.coverType}
    type="article"
    schema={schema}
    publishedTime={post.date}
    tags={post.tags}
    keywords={[...post.tags, ...(post.category ? [post.category] : [])]}
    hasCode={hasCode}
>
    <article class="article">
        <header class="article__header">
            <h1 class="article__title">{post.title}</h1>
            <time class="article__date" datetime={post.date}>
                {formatDate(post.date)}
            </time>
            {post.description && <p class="article__description">{post.description}</p>}
        </header>
        <div class="prose" set:html={post.html} />
    </article>
</Base>
