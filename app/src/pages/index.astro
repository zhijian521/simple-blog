---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getNotes } from '../lib/notes.js';
import config from '../../site.config.mjs';

const notes = getNotes();
const visibleNotes = notes.slice(0, config.postsOnHome);
const schema = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: config.name,
    url: `${config.url}/`,
    description: config.description,
    inLanguage: config.locale,
    author: { '@type': 'Person', name: config.author },
};
---
<Base schema={schema}>
    <section class="intro" aria-labelledby="intro-title">
        <h1 class="intro__title" id="intro-title">{config.name}</h1>
        <p class="intro__role"><span class="intro__sep" aria-hidden="true">·</span>{config.role}</p>
    </section>

    <section class="section" aria-labelledby="projects-title">
        <h2 class="section__title" id="projects-title">项目</h2>
        <ul class="plain-list">
            {
                config.projects.map((project) => (
                    <li class="plain-list__item">
                        {project.href ? (
                            <a class="plain-list__name" href={project.href} target="_blank" rel="noopener noreferrer">
                                {project.title}
                            </a>
                        ) : (
                            <span class="plain-list__name">{project.title}</span>
                        )}
                        <span class="plain-list__description">{project.description}</span>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="section" id="notes" aria-labelledby="notes-title">
        <h2 class="section__title" id="notes-title">文章</h2>
        {visibleNotes.length ? <PostList posts={visibleNotes} /> : <p class="empty">还没有文章。</p>}
        {notes.length > visibleNotes.length && <a class="archive-link" href="/page/1/">归档</a>}
    </section>
</Base>
