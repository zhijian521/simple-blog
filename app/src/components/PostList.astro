---
import { formatDate } from '../lib/notes.js';
const { posts } = Astro.props;
---
<div class="post-list">
    {posts.map((post) => (
        <article class="post-list__item">
            <div class="post-list__meta"><time datetime={post.date}>{formatDate(post.date)}</time>{post.tags.length > 0 && <span>{post.tags.join(' · ')}</span>}</div>
            <h3 class="post-list__title"><a href={post.url}>{post.title}</a></h3>
            {post.description && <p class="post-list__description">{post.description}</p>}
        </article>
    ))}
</div>
